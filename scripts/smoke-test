#!/usr/bin/env python3
"""Install and start Orchard through ./orchard on a few generated images and a video, and check the API lists them.

Runs on any Python 3, so it also shows what ./orchard says when Python is too old. --visual also downloads the search
model and runs a search. Pass a lasting --data-dir to keep the model between runs. --launcher tests a built app instead,
through Orchard.app/Contents/MacOS/Orchard or Orchard.exe."""
import argparse
import contextlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import time
import urllib.request
import zlib

ROOT = Path(__file__).resolve().parent.parent
LAUNCHER = ROOT / ('orchard.cmd' if sys.platform == 'win32' else 'orchard')
COLOURS = {'red': (220, 30, 30), 'green': (30, 160, 60), 'blue': (30, 60, 220), 'yellow': (240, 210, 30)}
# The video: frames of a colour none of the images has, so search never stacks it with one, lasting a second.
VIDEO_COLOUR, FRAMES, RATE = (130, 40, 170), 4, 4
INSTALL_SECONDS = 600
WORK_SECONDS = 600


def png(path, rgb, size=64):
    """Write a plain square PNG of one colour, with only the standard library."""
    def chunk(kind, data):
        return struct.pack('>I', len(data)) + kind + data + struct.pack('>I', zlib.crc32(kind + data))
    pixels = zlib.compress((b'\0' + bytes(rgb) * size) * size)
    header = struct.pack('>IIBBBBB', size, size, 8, 2, 0, 0, 0)
    path.write_bytes(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', header) + chunk(b'IDAT', pixels) + chunk(b'IEND', b''))


def avi(path, rgb, size=16):
    """Write an uncompressed AVI of FRAMES frames of one colour at RATE a second, with only the standard library. It
    checks that the app's video reader, PyAV and the FFmpeg it brings, loads."""
    def chunk(kind, data):
        return kind + struct.pack('<I', len(data)) + data + b'\0' * (len(data) % 2)

    def listed(kind, *chunks):
        return chunk(b'LIST', kind + b''.join(chunks))
    row = (size * 3 + 3) // 4 * 4
    frames = [(bytes(reversed(rgb)) * size + b'\0' * (row - size * 3)) * size] * FRAMES
    main = struct.pack('<14I', 1_000_000 // RATE, 0, 0, 0x10, len(frames), 0, 1, row * size, size, size, 0, 0, 0, 0)
    stream = struct.pack('<4s4sIHHIIIIIIIIhhhh', b'vids', b'DIB ', 0, 0, 0, 0, 1, RATE, 0, len(frames), row * size, 0xFFFFFFFF, 0, 0, 0, size, size)
    bitmap = struct.pack('<IiiHHIIiiII', 40, size, size, 1, 24, 0, row * size, 0, 0, 0, 0)
    movie = b''.join(chunk(b'00db', frame) for frame in frames)
    # Offsets count from the movie list's own name.
    index = b''.join(struct.pack('<4sIII', b'00db', 0x10, 4 + place * (8 + row * size), row * size) for place in range(len(frames)))
    header = listed(b'hdrl', chunk(b'avih', main), listed(b'strl', chunk(b'strh', stream), chunk(b'strf', bitmap)))
    path.write_bytes(chunk(b'RIFF', b'AVI ' + header + listed(b'movi', movie) + chunk(b'idx1', index)))


def call(url, data=None):
    request = urllib.request.Request(url, data, {'Content-Type': 'application/json'} if data else {})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def wait(server, launcher, seconds, what, check):
    """Poll until check returns a truthy value, failing early if the server exits."""
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if server.poll() is not None:
            sys.exit(f'FAIL: {launcher.name} exited with status {server.returncode} while waiting for {what}.')
        try:
            result = check()
        except OSError:
            result = None
        if result:
            return result
        time.sleep(2)
    sys.exit(f'FAIL: timed out waiting for {what}.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--port', type=int, default=4499, help='port for the test server; not the default, so it never meets a running Orchard')
    parser.add_argument('--data-dir', type=Path, help='cache folder; defaults to a temporary one')
    parser.add_argument('--visual', action='store_true', help='also download the search model and run a search')
    parser.add_argument('--launcher', type=Path, default=LAUNCHER, help='what starts Orchard; defaults to the launcher in this folder')
    args = parser.parse_args()
    with socket.socket() as probe:
        if probe.connect_ex(('127.0.0.1', args.port)) == 0:
            sys.exit(f'FAIL: port {args.port} is already in use. Choose another with --port.')
    scratch = Path(tempfile.mkdtemp(prefix='orchard-smoke-'))
    photos, data = scratch / 'photos', args.data_dir or scratch / 'data'
    (photos / 'nested').mkdir(parents=True)
    for name, rgb in COLOURS.items():
        png(photos / f'{name}.png', rgb)
    shutil.copy(photos / 'red.png', photos / 'nested' / 'red copy.png')
    avi(photos / 'purple.avi', VIDEO_COLOUR)
    url = f'http://127.0.0.1:{args.port}'
    # --browser, since CI has no screen, and BROWSER makes opening it a no-op. With no input, the Windows launcher's
    # pause after a failure returns at once.
    # In its own session on macOS and Linux, so stopping it also stops the Python a launcher started.
    server = subprocess.Popen([str(args.launcher), str(photos), '--port', str(args.port), '--data-dir', str(data), '--no-watch', '--browser'],
                              env={**os.environ, 'BROWSER': 'cmd /c rem' if sys.platform == 'win32' else 'true'}, stdin=subprocess.DEVNULL,
                              start_new_session=sys.platform != 'win32')
    try:
        def scanned():
            library = call(f'{url}/api/status')['library']
            return library if library and library['updated'] and library['scan']['state'] == 'ready' else None
        counts = wait(server, args.launcher, INSTALL_SECONDS, 'the first scan', scanned)['counts']
        expected = (len(COLOURS) + 1, len(COLOURS) + 2, 1)
        if (counts['images'], counts['files'], counts['videos']) != expected:
            sys.exit(f'FAIL: expected {expected[0]} images, one a video, in {expected[1]} files, got {counts}.')
        items = call(f'{url}/api/images')['items']
        if len(items) != expected[0] or sum(item['copies'] for item in items) != expected[1]:
            sys.exit(f'FAIL: /api/images listed {[item["path"] for item in items]}.')
        video = next(item for item in items if item['path'] == 'purple.avi')
        if not video['mime'].startswith('video/') or abs((video['duration'] or 0) - FRAMES / RATE) > .1:
            sys.exit(f'FAIL: the video was read as {video["mime"]}, {video["duration"]} seconds long.')
        print(f'PASS: scanned {counts["images"]} images, one a video, in {counts["files"]} files.')
        with urllib.request.urlopen(url, timeout=30) as response:
            script = re.search(r'src="(/assets/[^"]+\.js)"', response.read().decode())
        if not script:
            sys.exit('FAIL: the page does not load its script. Is dist/ built?')
        urllib.request.urlopen(url + script[1], timeout=30).close()
        print('PASS: the page and its script load.')
        if args.visual:
            call(f'{url}/api/search/index', b'{}')
            def indexed():
                search = call(f'{url}/api/status')['library']['search']
                if search['state'] == 'error':
                    sys.exit(f'FAIL: visual search failed: {search.get("error")}')
                return search['state'] == 'ready'
            wait(server, args.launcher, WORK_SECONDS, 'visual search', indexed)
            items = call(f'{url}/api/images?mode=visual&q=a+blue+square')['items']
            if not items or Path(items[0]['path']).name != 'blue.png':
                sys.exit(f'FAIL: searching for blue found {[item["path"] for item in items]}.')
            print('PASS: visual search found the blue image first.')
    finally:
        if sys.platform == 'win32':
            # Terminating would stop only the launcher, cmd.exe or Orchard.exe, and leave the server running.
            subprocess.run(['taskkill', '/T', '/F', '/PID', str(server.pid)], capture_output=True)
        else:
            # The launcher may have stopped already, while the Python it started has not.
            with contextlib.suppress(ProcessLookupError):
                os.killpg(server.pid, signal.SIGTERM)
        server.wait()
        shutil.rmtree(scratch)


if __name__ == '__main__':
    main()
