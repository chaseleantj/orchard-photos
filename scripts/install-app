#!/bin/zsh
# Install Orchard.app, which opens this clone's window from the Dock or Spotlight: scripts/install-app [folder]
# The app goes into ~/Applications, or into folder when one is given.
set -e
[[ $(uname) == Darwin ]] || { print -u2 'scripts/install-app builds a Mac app. On Linux, run ./orchard.'; exit 1; }
command -v clang > /dev/null || { print -u2 'scripts/install-app compiles the app with clang. Install the command line tools with xcode-select --install, then run it again.'; exit 1; }
root=${0:A:h:h}
app=${${1:-~/Applications}:A}/Orchard.app

# The app's executable is the compiled launcher the downloadable app uses, so macOS asks to allow the clone's folder,
# like one on the Desktop, and remembers the answer. A script there would be refused without asking. It runs
# Contents/Resources/start, which runs ./orchard. server/window.py then reruns Python through Contents/MacOS/python, a
# link to Python's own app binary, so macOS shows the window as Orchard's, not Python's.
rm -rf $app
mkdir -p $app/Contents/MacOS $app/Contents/Resources
clang -O2 -DSTART_SCRIPT -o $app/Contents/MacOS/Orchard $root/scripts/app/macos-launcher.c
cp $root/assets/orchard.icns $app/Contents/Resources/Orchard.icns
cat > $app/Contents/Info.plist <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Orchard</string>
  <key>CFBundleIdentifier</key><string>local.orchard.launcher</string>
  <key>CFBundleExecutable</key><string>Orchard</string>
  <key>CFBundleIconFile</key><string>Orchard.icns</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSAppleEventsUsageDescription</key><string>Orchard opens Photos at a photo when you choose Show in Photos.</string>
  <key>NSPhotoLibraryUsageDescription</key><string>Orchard shows and searches the photos in your Photos library. It never changes them.</string>
</dict>
</plist>
PLIST

# Apps start with a bare PATH, so reuse this shell's, plus Homebrew's for a Python installed later.
cat > $app/Contents/Resources/start <<SCRIPT
export PATH='$PATH:/opt/homebrew/bin:/usr/local/bin'
export ORCHARD_BUNDLE="\$(cd "\$(dirname "\$0")/../.." && pwd)"
cd '$root'
# The same test as installed() in ./orchard: false when it is about to install packages.
installed() { test -f .venv/.installed && test -z "\$(find requirements.txt -newer .venv/.installed)"; }
if ! installed; then
  osascript -e 'display dialog "Setting up Orchard. This takes about a minute, and the window opens when it is ready." with title "Orchard" buttons {"OK"} default button 1' > /dev/null 2>&1 &
  dialog=\$!
  # The dialog closes before the window opens, or macOS shows the two under separate Dock icons.
  (until installed; do sleep 0.5; done; kill \$dialog 2> /dev/null) &
  watcher=\$!
fi
status=0
./orchard "\$@" || status=\$?
if [ -n "\$dialog" ]; then kill \$watcher \$dialog 2> /dev/null; fi
exit \$status
SCRIPT
ln -s $root/.venv/app-python $app/Contents/MacOS/python
# Signed, so macOS can remember what the user lets it open, like folders on the Desktop.
codesign --force --sign - $app
touch $app
# Only the installed app is registered, so a test build elsewhere leaves no second Orchard for Spotlight to find.
if [[ -z $1 ]]; then
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f $app
fi
print "Installed $app"
